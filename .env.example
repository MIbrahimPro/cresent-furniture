# Copy to .env and fill in your values
PEXELS_API=your-pexels-api-key
MONGODB_URI=mongodb://localhost:27017/crescent
# Optional: database name when sharing a cluster (defaults to "crescent")
# MONGODB_DB=crescent
# Public base URL of the site (used for meta/OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
